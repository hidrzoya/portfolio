# Copy this file to `.env.local` for local development or set the same values
# in your deployment environment for production.

SECRET_KEY=replace-me
DEBUG=false

ALLOWED_HOSTS=replace-me
CORS_ALLOWED_ORIGINS=https://replace-me
CSRF_TRUSTED_ORIGINS=https://replace-me

# Preferred for production (for example, the Neon connection string from Vercel).
DATABASE_URL=postgresql://replace-me
BLOB_READ_WRITE_TOKEN=replace-me

AZURE_AD_TENANT_ID=replace-me
AZURE_AD_CLIENT_ID=replace-me
AZURE_AD_CLIENT_SECRET=replace-me
AZURE_AD_REDIRECT_URI=https://replace-me/azure/microsoft/callback/
POST_LOGOUT_REDIRECT_URI=https/replace-me/login-redirect
REACT_LOGIN_SUCCESS_URL=https://replace-me/auth/callback
AZURE_AD_SHAREPOINT_SCOPES=Sites.Selected
AZURE_AD_SHAREPOINT_DEFAULT_SITE_ID=replace-me
AZURE_AD_SHAREPOINT_DEFAULT_SITE_URL=https://replace-me.sharepoint.com/sites/AIKnowledgeBased/default.aspx

DB_NAME=replace-me
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=replace-me
DB_PORT=5432
DB_SSLMODE=require

AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_MAX_COMPLETION_TOKENS=2000

# OCR native binaries for scanned PDFs/images.
# Windows examples:
# POPPLER_PATH=C:\Program Files\poppler\Library\bin
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=
TESSERACT_CMD=

# PMGSCv3 ticket integration.
# Keep secrets in `.env.local` or your deployment secret store, never in source control.
PMGSCV3_API_BASE_URL=https://pmgsc.planate.com
PMGSCV3_CREATE_TICKET_PATH=/api/tickets/fina/
PMGSCV3_TICKET_STATUS_PATH=/api/tickets/fina/status/
FINA_PMGSC_TICKET_API_URL=https://pmgsc.planate.com/api/tickets/fina/
FINA_PMGSC_TICKET_STATUS_API_URL=https://pmgsc.planate.com/api/tickets/fina/status/
FINA_PMGSC_TICKET_API_TOKEN=replace-me
PMGSCV3_TICKET_AUTH_SCHEME=ApiKey
PMGSCV3_TICKET_API_KEY=
PMGSCV3_TICKET_API_KEY_HEADER=X-API-Key
PMGSCV3_TICKET_API_TIMEOUT=15
